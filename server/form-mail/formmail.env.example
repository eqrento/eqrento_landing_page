# Settings of formmail.py – copy to formmail.env ON THE SERVER, fill in, keep it readable only by the service
# (chmod 600). Never put the filled-in file in this repository: the repository is public.
# Works as a systemd EnvironmentFile= and as a Docker env_file (KEY=value, no quotes).

# Who gets the requests (several addresses: comma-separated) and which address sends them.
MAIL_TO=sales@example.com
MAIL_FROM=website@example.com
MAIL_FROM_NAME=EQrento website

# How the e-mail is sent. Three usual ways with Google Workspace:
#   1) SMTP relay with the server's address allowed in the Google Admin console (no password at all):
#        SMTP_HOST=smtp-relay.gmail.com  SMTP_PORT=587  SMTP_SECURITY=starttls   and no SMTP_USER / SMTP_PASSWORD
#   2) a mailbox with an app password:
#        SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_SECURITY=starttls  SMTP_USER=<mailbox>  SMTP_PASSWORD=<app password>
#   3) the SMTP account the EQrento application already uses for its own e-mails.
SMTP_HOST=smtp-relay.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
# The name the service introduces itself with to the mail server (default: the domain of MAIL_FROM).
SMTP_HELO=

# Where the service listens and which address it answers. In a container use FORM_HOST=0.0.0.0.
FORM_HOST=127.0.0.1
FORM_PORT=8787
FORM_PATH=/api/demo-request

# Spam limits: requests per visitor address in a time window (seconds); a form filled in faster than MIN_SECONDS is a bot.
RATE_LIMIT=5
RATE_WINDOW=600
MIN_SECONDS=3

# Only if the form page is on another address than this service (not needed behind nginx on eqrento.com).
ALLOW_ORIGIN=
